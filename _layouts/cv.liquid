---
layout: default
---

<style>
  :root {
    /* 这里控制“吃掉左侧边栏”的宽度，自己可调 */
    --pdf-left-expand: 260px;
    --pdf-right-expand: 0px;
  }

  /* 保持顶部区域原样，不改 post 宽度 */
  .post-header {
    margin-bottom: 1.5rem;
  }

  /* 只让 PDF 这一块变宽 */
  .pdf-breakout {
    width: calc(100% + var(--pdf-left-expand) + var(--pdf-right-expand));
    margin-left: calc(-1 * var(--pdf-left-expand));
    margin-right: calc(-1 * var(--pdf-right-expand));
  }

  .pdf-frame {
    width: 100%;
    height: 90vh;
    border: none;
    display: block;
  }

  /* 手机上不要向左撑出去 */
  @media (max-width: 992px) {
    .pdf-breakout {
      width: 100%;
      margin-left: 0;
      margin-right: 0;
    }

    .pdf-frame {
      height: 80vh;
    }
  }
</style>

<div class="post">
  <header class="post-header">
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    <div class="pdf-breakout">
      <iframe
        class="pdf-frame"
        src="{{ 'assets/pdf/Junxiao_Zhang_CV.pdf' | relative_url }}"
        title="Curriculum Vitae">
      </iframe>
      <div class="pdf-mobile-link" style="display:flex; justify-content:center; align-items:center; margin-top:2rem;">
        <a
          href="{{ 'assets/pdf/Junxiao_Zhang_CV.pdf' | relative_url }}"
          target="_blank"
          rel="noopener noreferrer"
          style="text-decoration:none; padding:20px;"
        >
          <i class="fa-solid fa-file-pdf" style="font-size:60px;"></i>
        </a>
      </div>
    </div>
  </article>
</div>