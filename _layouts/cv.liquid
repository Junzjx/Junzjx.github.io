---
layout: default
---

<style>
  :root {
    --pdf-left-expand: 260px;
    --pdf-right-expand: 0px;
  }

  .post-header {
    margin-bottom: 1.5rem;
  }

  .pdf-breakout {
    width: calc(100% + var(--pdf-left-expand) + var(--pdf-right-expand));
    margin-left: calc(-1 * var(--pdf-left-expand));
    margin-right: calc(-1 * var(--pdf-right-expand));
  }

  .pdf-frame {
    width: 100%;
    height: 90vh;
    border: none;
    display: block;
  }

  .pdf-mobile-link {
    display: none !important;
  }

  @media (max-width: 992px) {
    .pdf-breakout {
      width: 100%;
      margin-left: 0;
      margin-right: 0;
    }

    .pdf-frame {
      display: none;
    }

    .pdf-mobile-link {
      display: block !important;
      width: 100%;
      text-align: center;
      margin-top: 2rem;
    }
  }
</style>

<div class="post">
  <header class="post-header">
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    {{ content }}
  </article>
</div>
